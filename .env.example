# Variáveis de ambiente do Lovable Cloud (Supabase)
# Copie este arquivo para `.env` e preencha com os valores reais do seu projeto.
# NUNCA comite o `.env` real — ele está no `.gitignore`.

# URL pública da API do projeto Supabase (ex.: https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=YOUR_SUPABASE_URL

# Chave pública (anon/publishable) — segura para o front-end
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# ID do projeto Supabase (ex.: ebmopkmqutxycitqtbuz)
VITE_SUPABASE_PROJECT_ID=YOUR_SUPABASE_PROJECT_ID
